# Nadar Saraswathi College of Engineering and Technology (NSCET)
# Environment Configuration Template
APP_ENV=dev
LOG_LEVEL=INFO
API_KEY=change-me-please

# College Authentication & Authorization
ALLOWED_EMAIL_DOMAIN=nscet.edu.in
JWT_SECRET=replace-with-a-secure-random-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
KIOSK_TOKEN=replace-with-a-secure-kiosk-token

# Database & Storage
DATABASE_URL=sqlite:///./db/attendance.db
# DATABASE_URL=postgresql+psycopg2://attendance:attendance@postgres:5432/attendance
SNAPSHOTS_DIR=db/snapshots
RAW_DIR=db/raw
STORE_SNAPSHOTS=true
STORE_RAW_IMAGES=false
RETENTION_DAYS=365

# Redis (leave empty for single-process in-memory cache)
# REDIS_URL=redis://localhost:6379/0

# Vision Engine
DETECTOR=yolo
YOLO_WEIGHTS=models/yolov11s-face.pt
DEVICE=auto

# Face Recognition Parameters
MATCH_THRESHOLD=0.45
DUPLICATE_THRESHOLD=0.65
CONFIRM_FRAMES=3
FRAME_SKIP=2
LIVENESS_ENABLED=false

# Timezone & API
TIMEZONE=Asia/Kolkata
API_URL=http://localhost:8000
